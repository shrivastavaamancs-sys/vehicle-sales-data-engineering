{
	"name": "silver_to_gold",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet3",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Parquet4",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Order_ID as integer,",
				"          Order_Date as timestamp,",
				"          Ship_Date as date,",
				"          Customer_ID as integer,",
				"          Customer_Name as string,",
				"          segment as string,",
				"          country as string,",
				"          city as string,",
				"          state as string,",
				"          region as string,",
				"          category as string,",
				"          sales as string,",
				"          profit as integer,",
				"          Sales as decimal(10,2),",
				"          Profit as decimal(10,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> source1",
				"source1 aggregate(groupBy(Region = region),",
				"     profit = sum(source1@profit),",
				"          Sales = sum(source1@Sales)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}