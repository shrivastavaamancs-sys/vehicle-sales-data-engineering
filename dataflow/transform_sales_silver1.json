{
	"name": "transform_sales_silver1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText3",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText4",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Order ID} as integer,",
				"          {Order Date} as string,",
				"          {Customer Name} as string,",
				"          Region as string,",
				"          City as string,",
				"          Category as string,",
				"          {Sub-Category} as string,",
				"          {Product Name} as string,",
				"          Quantity as string,",
				"          {Unit Price} as string,",
				"          Discount as string,",
				"          Sales as integer,",
				"          Profit as integer,",
				"          {Payment Mode} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 aggregate(groupBy(Region,",
				"          Category),",
				"     totalsales = sum(Sales),",
				"          {Total Profit} = sum(Profit),",
				"          {Total Orders} = count({Order ID})) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Category as string,",
				"          Region as string,",
				"          Total_Sales as string,",
				"          Total_Profit as string,",
				"          Total_Orders as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}